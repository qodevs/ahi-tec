# AHI-TEC E-Mail & SMTP Konfiguration
# Diese Variablen können lokal in .env.local oder im Vercel Dashboard unter "Environment Variables" hinterlegt werden.

# SMTP Server Einstellungen (IONOS Standard)
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_SECURE=true

# IONOS E-Mail Zugangsdaten
SMTP_USER=info@ahi-tec.de
SMTP_PASS=ihr_ionos_email_passwort

# Empfänger-Adresse für Anfragen (Standard: info@ahi-tec.de)
CONTACT_TO_EMAIL=info@ahi-tec.de
